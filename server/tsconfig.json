{
  // Used by `npm run typecheck` and the editor: checks app code, tests, and scripts.
  // The production build uses tsconfig.build.json, which compiles only src/.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "prisma", "prisma.config.ts", "vitest.config.ts"]
}
