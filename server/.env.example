# Copy this file to .env and adjust if needed. Never commit .env.
NODE_ENV=development
PORT=4000
# Matches the Postgres container in docker-compose.yml
DATABASE_URL="postgresql://finance:finance@localhost:5432/finance_tracker"
# Separate database for automated tests (created by docker/postgres/init.sql)
DATABASE_URL_TEST="postgresql://finance:finance@localhost:5432/finance_tracker_test"
